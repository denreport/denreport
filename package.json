{
  "name": "denreport",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && bash scripts/check-comment-refs.sh && bash scripts/check-version-sync.sh"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@biomejs/biome": "2.5.4",
    "vitest": "4.1.10"
  }
}

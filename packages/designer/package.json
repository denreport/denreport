{
  "name": "@denreport/designer",
  "version": "0.1.0",
  "description": "Embeddable, browser-based visual designer UI for denreport business documents (invoices, delivery notes, receipts), exposed as a small Designer class.",
  "license": "MIT",
  "homepage": "https://www.den.report/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denreport/denreport.git",
    "directory": "packages/designer"
  },
  "bugs": {
    "url": "https://github.com/denreport/denreport/issues"
  },
  "keywords": [
    "report",
    "invoice",
    "pdf",
    "form-designer",
    "editor",
    "react",
    "ir",
    "denreport"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles/tokens.css": "./src/ui/styles/tokens.css",
    "./styles/app.css": "./src/ui/styles/app.css"
  },
  "files": [
    "dist",
    "src/ui/styles/*.css"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles/tokens.css": "./src/ui/styles/tokens.css",
      "./styles/app.css": "./src/ui/styles/app.css"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@denreport/core": "workspace:*",
    "@denreport/targets": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}

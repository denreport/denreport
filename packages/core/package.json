{
  "name": "@denreport/core",
  "version": "0.1.0",
  "description": "Open, versioned JSON intermediate representation (IR) for business documents (invoices, delivery notes, receipts), with a parser, a validator, and per-target compatibility matrices. No UI, no rendering.",
  "license": "MIT",
  "homepage": "https://www.den.report/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denreport/denreport.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/denreport/denreport/issues"
  },
  "keywords": [
    "report",
    "invoice",
    "pdf",
    "ir",
    "intermediate-representation",
    "json-schema",
    "parser",
    "validator",
    "denreport"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  }
}

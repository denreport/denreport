{
  "name": "@denreport/targets",
  "version": "0.1.0",
  "description": "Exporters from the denreport IR to pdfme templates and self-contained ReportLab Python scripts. Bundles Noto Sans JP for Japanese typesetting.",
  "license": "MIT",
  "homepage": "https://www.den.report/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denreport/denreport.git",
    "directory": "packages/targets"
  },
  "bugs": {
    "url": "https://github.com/denreport/denreport/issues"
  },
  "keywords": [
    "report",
    "invoice",
    "pdf",
    "pdfme",
    "reportlab",
    "ir",
    "exporter",
    "denreport"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "assets"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@denreport/core": "workspace:*"
  },
  "devDependencies": {
    "@pdfme/common": "6.1.11",
    "@pdfme/generator": "6.1.11",
    "@pdfme/schemas": "6.1.11",
    "@types/node": "^26.1.2",
    "pdfjs-dist": "6.1.200"
  }
}
